# ⚠️ .gitignore ไม่รองรับคอมเมนต์ท้ายบรรทัด
#    "data/sessions/   # หมายเหตุ" จะถูกอ่านเป็นชื่อ path ทั้งก้อน แล้วไม่ match อะไรเลย
#    คอมเมนต์ต้องอยู่บรรทัดของตัวเองเท่านั้น

# ── ความลับ: ห้าม commit เด็ดขาด ──────────────────────────────
.env

# cookie หลังบ้านร้านค้า — หลุดแล้วคนอื่นเข้าจัดการร้านได้เลย
# ห้าม git add -f เด็ดขาด (ต่างจาก sold_history.csv ใน pdp-scraper)
data/sessions/
data/profiles/
.browser_profile/
.chrome_cdp/

# ── ข้อมูล/ผลลัพธ์: สร้างใหม่ได้เสมอ ──────────────────────────
data/raw/
output/
logs/
*.db
# ไฟล์ข้างเคียงของ SQLite ตอนเปิด WAL — *.db ไม่ครอบเพราะคนละนามสกุล
# -wal มีข้อมูลแถวจริงอยู่ข้างใน ห้าม commit เช่นเดียวกับตัวฐานเอง
*.db-wal
*.db-shm
*.db-journal
*.lock

# ── Python ────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# คลังข้อมูล Excel — ใหญ่และสร้างใหม่ได้จาก output/
output/_คลังข้อมูล/

# log การโหลดขึ้น Postgres
output/_pg_logs/
