# ─────────────────────────────────────────────────────────────
#  คัดลอกเป็น .env แล้วเติมค่า:   copy .env.example .env
#  .env อยู่ใน .gitignore แล้ว จะไม่ถูก commit
#
#  ⛔ ห้ามใส่รหัสผ่านในไฟล์นี้ หรือไฟล์ไหนก็ตามในโปรเจกต์นี้
#     ระบบไม่เก็บรหัสผ่านเลยแม้แต่ที่เดียว — ล็อกอินด้วยมือครั้งเดียวต่อร้าน
#     ผ่านคำสั่ง `python -m src.cli login --shop <shop_id>` แล้วระบบเก็บ
#     เฉพาะ cookie ไว้ที่ data/sessions/ (ซึ่งก็อยู่ใน .gitignore เช่นกัน)
#
#  ค่า *_ACCOUNT ข้างล่างเก็บแค่ "อีเมลที่ใช้ล็อกอิน" ไว้เตือนความจำว่า
#  ร้านไหนต้องล็อกอินด้วยบัญชีอะไร — ไม่ใช่ความลับ แต่ก็ไม่ควรขึ้น git
# ─────────────────────────────────────────────────────────────

# ── บัญชีที่ใช้ล็อกอินของแต่ละร้าน ───────────────────────────
LAZADA_01_ACCOUNT=
TIKTOK_01_ACCOUNT=
TIKTOK_02_ACCOUNT=
TIKTOK_03_ACCOUNT=
TIKTOK_04_ACCOUNT=
TIKTOK_05_ACCOUNT=

# ── URL หลังบ้าน (แก้ที่นี่ที่เดียวถ้าโดเมนเปลี่ยน) ──────────
LAZADA_SELLER_URL=https://sellercenter.lazada.co.th
TIKTOK_SELLER_URL=https://seller-th.tiktok.com
SHOPEE_SELLER_URL=https://seller.shopee.co.th

# ── โหมด CDP (เผื่อ TikTok บล็อกเบราว์เซอร์ที่ Playwright เปิดเอง) ──
# วิธีเปิด Chrome ให้สคริปต์เกาะ ดูใน README
CHROME_CDP_PORT=9222

# ── Phase 5: Official API (ยังไม่ได้ใช้ — ยังไม่มีสิทธิ์) ────
# LAZADA_APP_KEY=
# LAZADA_APP_SECRET=
# TIKTOK_APP_KEY=
# TIKTOK_APP_SECRET=
